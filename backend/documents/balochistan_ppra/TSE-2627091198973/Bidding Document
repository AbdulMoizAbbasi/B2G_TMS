                    var parser = new DOMParser;
                    var dom = parser.parseFromString(
                        '<!doctype html><body>' + html,
                        'text/html');
                    return dom.body.textContent;
                }
                function DecodeinnerHtml(html) {
                    var parser = new DOMParser;
